<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_session_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:minHeight="59dp" android:paddingTop="3dp" android:paddingBottom="3dp">
    <TextView android:id="@+id/widget_session_accent"
        android:layout_width="3dp" android:layout_height="39dp"
        android:background="#89919E"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginLeft="9dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_session_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:textStyle="bold" android:textSize="14sp" android:textColor="#dbd7cc"/>
        <TextView android:id="@+id/widget_session_project"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
            android:textSize="11sp" android:textColor="#b8b3aa"/>
        <LinearLayout android:id="@+id/widget_session_gitrow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/widget_session_github"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:ellipsize="end"
                android:maxLines="1" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#8dc0e7" android:visibility="gone"
                android:paddingLeft="6dp" android:paddingRight="6dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="@drawable/widget_session_github_bg"/>
            <TextView android:id="@+id/widget_session_branch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="91dp" android:ellipsize="end"
                android:maxLines="1" android:textSize="10sp"
                android:textColor="#65b4a2" android:visibility="gone"
                android:layout_marginLeft="4dp"
                android:paddingLeft="6dp" android:paddingRight="6dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="@drawable/widget_session_branch_bg"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="88dp"
        android:layout_height="51dp" android:layout_marginLeft="6dp"
        android:gravity="top|right" android:orientation="vertical">
        <!-- A plain TextView is reliable inside Android collection widgets.
             Status is never contingent on a nested bitmap overlay. -->
        <TextView android:id="@+id/widget_session_badge"
            android:layout_width="match_parent" android:layout_height="27dp"
            android:gravity="center" android:textSize="12sp"
            android:textStyle="bold" android:maxLines="1"
            android:paddingLeft="3dp" android:paddingRight="3dp"
            android:background="@drawable/widget_session_status_bg"/>
        <TextView android:id="@+id/widget_session_agent"
            android:layout_width="match_parent" android:layout_height="23dp"
            android:layout_marginTop="3dp"
            android:ellipsize="end" android:maxLines="1"
            android:paddingLeft="5dp" android:paddingRight="5dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:gravity="center"
            android:textColor="#e8a978" android:textSize="10sp"
            android:background="@drawable/widget_session_agent_bg"
            android:visibility="invisible"/>
    </LinearLayout>
</LinearLayout>
