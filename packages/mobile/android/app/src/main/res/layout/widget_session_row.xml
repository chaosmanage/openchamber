<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_session_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:minHeight="77dp" android:paddingTop="7dp" android:paddingBottom="7dp">
    <TextView android:id="@+id/widget_session_accent"
        android:layout_width="3dp" android:layout_height="45dp"
        android:background="#89919E"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginLeft="9dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_session_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:textStyle="bold" android:textSize="14sp" android:textColor="#F1F1F2"/>
        <TextView android:id="@+id/widget_session_project"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1"
            android:textSize="11sp" android:textColor="#B8BBC7"/>
        <LinearLayout android:id="@+id/widget_session_gitrow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/widget_session_github"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:ellipsize="end"
                android:maxLines="1" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#A3C8F2" android:visibility="gone"/>
            <TextView android:id="@+id/widget_session_branch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="91dp" android:ellipsize="end"
                android:maxLines="1" android:textSize="10sp"
                android:textColor="#C7B8DD" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="78dp"
        android:layout_height="wrap_content" android:layout_marginLeft="6dp"
        android:gravity="right|center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/widget_session_badge"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="11sp"
            android:textStyle="bold" android:maxLines="1"
            android:paddingLeft="4dp" android:paddingRight="4dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:background="@drawable/widget_provider_badge"/>
        <TextView android:id="@+id/widget_session_agent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end" android:maxLines="1"
            android:paddingLeft="5dp" android:paddingRight="5dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:gravity="center"
            android:textColor="#CAB4E6" android:textSize="10sp"
            android:background="@drawable/widget_provider_badge"
            android:visibility="invisible"/>
    </LinearLayout>
</LinearLayout>
