<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_session_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/widget_session_badge"
        android:layout_width="67dp" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="10sp"
        android:textStyle="bold" android:maxLines="1" android:padding="5dp"
        android:background="@drawable/widget_provider_badge"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginLeft="8dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_session_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:textStyle="bold" android:textSize="11sp" android:textColor="#E5E7EB"/>
        <TextView android:id="@+id/widget_session_project"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:textSize="10sp" android:textColor="#9CA3AF"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_session_agent"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="53dp" android:ellipsize="end" android:maxLines="1"
        android:padding="5dp" android:gravity="center"
        android:textColor="#CFC4E4" android:textSize="9sp"
        android:background="@drawable/widget_provider_badge"/>
</LinearLayout>
